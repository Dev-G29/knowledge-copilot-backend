# Copy to .env on the server (never commit the real file) and fill in every value.

# Public hostname of the API, e.g. kc-api.duckdns.org. Caddy gets the TLS certificate for it.
API_DOMAIN=kc-api.duckdns.org

# Database (only reachable inside the Docker network).
POSTGRES_DB=knowledge_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me-long-random

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=change-me
GEMINI_CHAT_MODEL=gemini-3.8-flash
# How long Gemini "thinks" before answering: MINIMAL (fastest) | LOW | MEDIUM | HIGH
GEMINI_THINKING_LEVEL=LOW

# Frontend origins allowed to call the API (comma-separated, no trailing slash; wildcards allowed).
CORS_ALLOWED_ORIGINS=https://knowledge-copilot.vercel.app,https://knowledge-copilot-*.vercel.app

# Admin account (can upload/delete documents). Seeded on first start.
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Set to true for one restart to reset an existing admin's password to ADMIN_PASSWORD.
ADMIN_SYNC_PASSWORD=false

RATE_LIMIT_CHAT_PER_MINUTE=20

# Image to run. CI pushes :latest and :<git-sha> to GHCR.
BACKEND_IMAGE=ghcr.io/dev-g29/knowledge-copilot-backend:latest

# Optional off-site backups (docker compose --profile offsite up -d).
# Endpoint format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
OCI_REGION=
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=
OCI_BUCKET=knowledge-copilot-backups
